meta {
  name: POST create sets
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/sets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "sets": [
      {
        "clientUuid": "2f6a5b9c-3e1d-4f0a-8b7c-9d2e1f0a3b4c",
        "exerciseId": "{{exerciseId}}",
        "weightKg": 60.5,
        "reps": 10,
        "rpe": 8.5,
        "notes": "Pesado",
        "isBodyweight": false,
        "performedAt": "2026-08-17T10:00:00.000Z"
      }
    ]
  }
}
