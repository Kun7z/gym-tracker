meta {
  name: POST register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "displayName": "João"
  }
}

vars:pre-request {
  email: teste@email.com.br
  password: minhaSenha123
  baseUrl: localhost:3000
}
